# Copy to .env (web dev), or .env.production before building for the
# Capacitor native apps (frontend/android, frontend/ios) — those bundle this
# build's output, so it must point at a real, reachable backend, not
# localhost (that resolves to the phone itself inside the app's WebView).
VITE_API_BASE_URL=http://localhost:8000/api/v1
