# Staging environment - NAMES and safe placeholders only. Never put a real secret in this file.
# On the staging droplet the real file is /root/app-staging/.env (mode 600), built with
# infra/staging/gen-secrets.sh and infra/staging/set-secret.sh. See docs/STAGING-SETUP.md.
# A blank value below means: filled in on the server, never in git.

# --- identity: must say staging ---
ENVIRONMENT=staging
APP_BASE_URL=https://staging.swingtrademl.com
FRONTEND_URL=https://staging.swingtrademl.com
CORS_ORIGINS=https://staging.swingtrademl.com

# --- safety flags (checked by infra/staging/preflight.sh) ---
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
ALLOW_REAL_HOLDINGS_ORDERS=false
ENABLE_SCHEDULER=false
BRAIN_ENABLED=false
TELEGRAM_ENABLED=false
# TESTING_NO_LIMITS: leave it out of this file entirely (unset).
ALLOW_SIGNUP=true
REQUIRE_EMAIL_VERIFICATION=true

# --- billing (Razorpay TEST mode only) ---
BILLING_ENABLED=true
BILLING_PROVIDER=razorpay
ALLOW_LIVE_BILLING=false
BILLING_ACCEPT_NEW_CHECKOUTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Name of the plan-id setting: confirm in docs/BILLING-SANDBOX.md on branch change/billing-razorpay-sandbox
RAZORPAY_PLAN_ID=

# --- email (Resend, staging-only sender) ---
EMAIL_PROVIDER=resend
EMAIL_FROM=TradeMind Staging <no-reply@send.staging.swingtrademl.com>
RESEND_API_KEY=

# --- generated on the server by gen-secrets.sh (leave blank here) ---
JWT_SECRET_KEY=
API_KEY=
POSTGRES_PASSWORD=
POSTGRES_USER=swingtrade
POSTGRES_DB=swing_trade_ml

# --- must stay EMPTY in staging (preflight fails if any is filled) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
