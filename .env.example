# =============================================================================
# Swing Trade ML — environment configuration
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is gitignored. NEVER commit real credentials.
#
# Every value here is read at process start (12-factor). When this moves to a
# cloud provider, these same keys come from the platform's secret manager
# instead of a file — no code changes required.
# =============================================================================

# -----------------------------------------------------------------------------
# Core application
# -----------------------------------------------------------------------------
APP_NAME=Swing Trade ML
# local | staging | production  — controls docs exposure and log format
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
# json | console  — use json in cloud so log aggregators can parse it
LOG_FORMAT=console
TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated origins allowed to call the API from a browser.
# https://localhost and capacitor://localhost are the origins the Android and
# iOS Capacitor app shells (frontend/android, frontend/ios) send on every
# request — add them once you're testing the mobile app builds.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost,http://<your-lan-ip>:5173

# Shared secret required on every protected endpoint via the `X-API-Key` header.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-generate-a-real-key

# Signs JWTs for the React dashboard login.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Self-registration for the dashboard. Fine to leave on for local development;
# turn off once everyone who should have an account does, since an open
# signup endpoint on a system that can place real trades is a real risk.
ALLOW_SIGNUP=true

# "Sign in with Google" for the dashboard. Get a Client ID/Secret from
# https://console.cloud.google.com/apis/credentials — create an OAuth 2.0
# Client ID of type "Web application" and add GOOGLE_REDIRECT_URL below as an
# authorized redirect URI. Leave GOOGLE_CLIENT_ID blank to disable entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Comma-separated emails allowed to sign in with Google. Required (not
# optional) — this is a personal trading tool, not a public app, and Google
# login must never silently mean "any Google account gets a trading bot."
GOOGLE_ALLOWED_EMAILS=

# -----------------------------------------------------------------------------
# PostgreSQL (TimescaleDB)
# -----------------------------------------------------------------------------
# These three are consumed by the postgres container in docker-compose.yml
POSTGRES_USER=swingtrade
POSTGRES_PASSWORD=swingtrade_local_pw
POSTGRES_DB=swing_trade_ml

# Host-facing URL — used when you run the API outside Docker (uvicorn on Windows).
# Port 5433, because the postgres container publishes there: a locally installed
# PostgreSQL usually already owns 5432, and connecting to that one by accident
# fails with a misleading authentication error.
DATABASE_URL=postgresql+psycopg://swingtrade:swingtrade_local_pw@localhost:5433/swing_trade_ml
# In-network URL — docker-compose overrides DATABASE_URL with this for api/worker.
DATABASE_URL_DOCKER=postgresql+psycopg://swingtrade:swingtrade_local_pw@postgres:5432/swing_trade_ml

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Create/upgrade all tables automatically when the server starts, so you never
# have to run DDL or migration commands by hand. This applies any pending
# Alembic migrations to `head` during app startup.
# Keep true for local development. In production, prefer running migrations as
# a separate deploy step and set this to false, so two API replicas booting at
# once can't race each other on the same migration.
DB_AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# Redis — scheduler locking, caching, future job queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

# -----------------------------------------------------------------------------
# TRADING MODE  ***  THE MOST IMPORTANT SETTING IN THIS FILE  ***
# -----------------------------------------------------------------------------
# paper : orders are simulated by the internal paper broker. Nothing is ever
#         sent to Zerodha. Market data is still real and live.
# live  : orders go to the real Zerodha account with real money.
#
# Plan: stay on `paper` for the first 6 months.
TRADING_MODE=paper

# Second, independent safety latch. Live orders require BOTH
# TRADING_MODE=live AND ALLOW_LIVE_TRADING=true. Keeping this false means a
# stray edit to TRADING_MODE alone cannot place a real order.
ALLOW_LIVE_TRADING=false

# -----------------------------------------------------------------------------
# Paper trading simulation parameters
# -----------------------------------------------------------------------------
# Starting virtual cash, INR
PAPER_STARTING_CAPITAL=1000000
# Simulated adverse price movement on fills, in basis points (10 bps = 0.10%)
PAPER_SLIPPAGE_BPS=5
# Brokerage per executed order, INR. Zerodha equity delivery is 0; intraday is
# 0.03% or Rs 20, whichever is lower.
PAPER_BROKERAGE_PER_ORDER=20
# Round-trip statutory charges estimate, in basis points on turnover
PAPER_TAX_BPS=12

# -----------------------------------------------------------------------------
# Zerodha Kite Connect
# Get these from https://developers.kite.trade/apps
# -----------------------------------------------------------------------------
KITE_API_KEY=
KITE_API_SECRET=
# The redirect URL is NOT set here — it lives on the Kite app itself
# (developers.kite.trade > your app > Redirect URL) and is the only thing that
# decides where Zerodha sends the browser after login. Point it at the host
# that actually runs the app: https://<your-host>/api/v1/auth/kite/callback,
# or http://localhost:8000/api/v1/auth/kite/callback when developing locally.
# Only one can be registered at a time, so a deployed instance and a local one
# cannot both receive logins — and re-logging in for local invalidates the
# deployed token, since Zerodha keeps one active token per API key.
# Kite access tokens expire daily at ~06:00 IST — a fresh login is required each
# trading day. The app stores the token in the DB and reloads it on startup.

# Optional: unattended daily login at 06:10 IST (see workers/scheduler.py),
# so a fresh Kite login doesn't depend on a human clicking "Log in to Kite"
# every trading morning. Leave all three blank to disable — the manual login
# flow keeps working as the fallback either way.
# KITE_USER_ID is your Zerodha client ID (e.g. AB1234). KITE_TOTP_SECRET is
# the base32 secret shown ONCE when you enable/reset "External TOTP" under
# Kite > Profile > Password & security — not the 6-digit code itself. If you
# only scanned the QR into an authenticator app and never saved the secret,
# you'll need to reset 2FA to see it again.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# -----------------------------------------------------------------------------
# Market data & ingestion
# -----------------------------------------------------------------------------
# Comma-separated NSE trading symbols tracked by default
DEFAULT_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,ITC,LT,AXISBANK,BHARTIARTL
# How far back to backfill daily candles on first run
HISTORICAL_BACKFILL_DAYS=1825
# Index used for relative-strength/regime ML features — not tradable, never
# watchlisted. Run `swingtrade sync-index` once to ingest it.
BENCHMARK_INDEX_SYMBOL=NIFTY 50
# Intraday candle interval used for live tracking: minute|3minute|5minute|15minute|30minute|60minute|day
LIVE_CANDLE_INTERVAL=15minute
# Seconds between live quote polls during market hours
LIVE_POLL_SECONDS=60
# NSE equity session, local exchange time (Asia/Kolkata)
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# -----------------------------------------------------------------------------
# Strategy engine
# -----------------------------------------------------------------------------
# Cron-style time (Asia/Kolkata) to run the daily swing scan, after close
SIGNAL_SCAN_CRON_HOUR=15
SIGNAL_SCAN_CRON_MINUTE=45
# Set false to run the API without the background scheduler (useful for tests)
ENABLE_SCHEDULER=true

# -----------------------------------------------------------------------------
# Risk limits — enforced in both paper and live mode
# -----------------------------------------------------------------------------
# Max fraction of portfolio value in a single position
MAX_POSITION_PCT=0.10
# Max number of concurrent open positions
MAX_OPEN_POSITIONS=10
# Fraction of equity risked per trade, used to size positions off the stop loss
RISK_PER_TRADE_PCT=0.01
# Default stop loss / target, as fractions of entry price
DEFAULT_STOP_LOSS_PCT=0.05
DEFAULT_TAKE_PROFIT_PCT=0.15
# Halt all new entries if portfolio drawdown from peak exceeds this fraction
MAX_PORTFOLIO_DRAWDOWN_PCT=0.20

# -----------------------------------------------------------------------------
# Machine learning
# -----------------------------------------------------------------------------
# Where trained model artifacts are written. Swap for an S3/GCS path in cloud.
MODEL_ARTIFACT_DIR=./data/models
# Trading days ahead the label looks, for the swing-return target
ML_PREDICTION_HORIZON_DAYS=5
# Forward return above which a sample is labelled a positive (2%)
ML_TARGET_RETURN_PCT=0.02
# Fraction of the (time-ordered) dataset held out for testing
ML_TRAIN_TEST_SPLIT=0.2
# Minimum predicted probability required before a BUY signal is emitted
ML_MIN_CONFIDENCE=0.60
ML_RANDOM_SEED=42

# -----------------------------------------------------------------------------
# Telegram notifications
# Create a bot with @BotFather, then message your bot once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
# -----------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated event types to push:
# signal,order,fill,error,daily_summary,system
TELEGRAM_NOTIFY_ON=signal,order,fill,error,daily_summary,system

# -----------------------------------------------------------------------------
# Frontend (Vite reads only VITE_* prefixed vars)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
